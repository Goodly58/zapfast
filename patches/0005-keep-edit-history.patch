diff --git a/src/kept_edits.rs b/src/kept_edits.rs
new file mode 100644
index 0000000..2b6376a
--- /dev/null
+++ b/src/kept_edits.rs
@@ -0,0 +1,86 @@
+//! Patched build: when someone edits a message, what it said before stays
+//! here, shown when you hover its "edited" mark.
+//!
+//! The archive's meta table keeps each message's earlier versions, oldest
+//! first, so they survive restarts. As with [`crate::kept_revokes`], the map is
+//! process-wide: the backend fills it and the conversation reads it.
+
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock, PoisonError};
+
+use crate::archive::Archive;
+use crate::model::Message;
+
+const META_KEY: &str = "fork_kept_edits";
+
+/// Earlier versions by `chat\tid`, oldest first.
+type Versions = HashMap<String, Vec<String>>;
+
+fn kept() -> &'static Mutex<Versions> {
+    static KEPT: OnceLock<Mutex<Versions>> = OnceLock::new();
+    KEPT.get_or_init(Default::default)
+}
+
+fn key(chat: &str, id: &str) -> String {
+    format!("{chat}\t{id}")
+}
+
+fn stored(archive: &Archive) -> Versions {
+    archive
+        .meta(META_KEY)
+        .ok()
+        .flatten()
+        .and_then(|json| serde_json::from_str(&json).ok())
+        .unwrap_or_default()
+}
+
+/// Restores the earlier versions this archive kept, when the backend starts.
+pub fn load(archive: &Archive) {
+    let stored = stored(archive);
+    kept()
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .extend(stored);
+}
+
+/// Keeps what someone else's message said before an edit replaces it with
+/// `new_text`. Our own edits are left alone: we know what we wrote.
+pub fn remember(archive: &Archive, old: &Message, new_text: &str) {
+    if old.from_me {
+        return;
+    }
+    let before = old.content.full_summary();
+    if before.is_empty() || before == new_text {
+        return;
+    }
+    let key = key(&old.chat, &old.id);
+    let mut stored = stored(archive);
+    let versions = stored.entry(key.clone()).or_default();
+    // The same edit can arrive twice, live and again from history.
+    if versions.last() == Some(&before) {
+        return;
+    }
+    versions.push(before);
+    let versions = versions.clone();
+    match serde_json::to_string(&stored) {
+        Ok(json) => {
+            if let Err(error) = archive.set_meta(META_KEY, &json) {
+                log::warn!("could not save an earlier version: {error}");
+            }
+        }
+        Err(error) => log::warn!("could not encode earlier versions: {error}"),
+    }
+    kept()
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .insert(key, versions);
+}
+
+/// What the message said before its edits, oldest first.
+pub fn versions(chat: &str, id: &str) -> Option<Vec<String>> {
+    kept()
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .get(&key(chat, id))
+        .cloned()
+}
