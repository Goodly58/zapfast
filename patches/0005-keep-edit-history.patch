+/// Patched build: the tooltip on "edited", with what the message said before.
+/// Each version goes through the bidi layout bubbles use, so right-to-left
+/// text keeps its word order.
+fn earlier_versions(ui: &mut egui::Ui, versions: &[String]) {
+    ui.label(match versions {
+        [_] => "Before the edit:",
+        _ => "Earlier versions, oldest first:",
+    });
+    let color = ui.visuals().text_color();
+    for version in versions {
+        let mut job = egui::text::LayoutJob::single_section(
+            version.clone(),
+            egui::TextFormat::simple(theme::regular(14.0), color),
+        );
+        job.wrap.max_width = 360.0;
+        ui.label(crate::bidi::layout_job(ui, job));
+    }
+}
