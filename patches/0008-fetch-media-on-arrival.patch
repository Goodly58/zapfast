+/// Whether an incoming attachment is fetched as soon as it arrives, so a
+/// later delete for everyone cannot take it: photos and voice notes within
+/// the automatic download limit that are not on disk yet.
+pub fn fetch_on_arrival(content: &Content) -> bool {
+    match content {
+        Content::Image { media, .. }
+        | Content::Audio {
+            media,
+            voice_note: true,
+            ..
+        } => media.path.is_none() && media.is_within_download_limit(),
+        _ => false,
+    }
+}
