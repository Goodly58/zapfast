+/// Patched build: the footer's word, "deleted" on a message its sender deleted
+/// for everyone that stays here, and "edited" as upstream.
+fn footer_note(message: &Message) -> Option<&'static str> {
+    let deleted = crate::kept_revokes::contains(&message.chat, &message.id);
+    match (deleted, message.edited) {
+        (true, true) => Some("deleted · edited"),
+        (true, false) => Some("deleted"),
+        (false, true) => Some("edited"),
+        (false, false) => None,
+    }
+}
