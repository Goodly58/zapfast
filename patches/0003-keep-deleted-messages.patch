diff --git a/src/kept_revokes.rs b/src/kept_revokes.rs
new file mode 100644
index 0000000..9be23bf
--- /dev/null
+++ b/src/kept_revokes.rs
@@ -0,0 +1,68 @@
+//! Patched build: messages others delete for everyone stay in the archive as
+//! they arrived, marked "deleted" in their footer.
+//!
+//! The archive's meta table remembers which ones, one `chat\tid` per line, so
+//! the mark survives restarts. The set is process-wide: the backend fills it
+//! and the conversation reads it while drawing footers.
+
+use std::collections::HashSet;
+use std::sync::{Mutex, OnceLock, PoisonError};
+
+use crate::archive::Archive;
+use crate::model::{Content, Message};
+
+const META_KEY: &str = "fork_kept_revokes";
+
+fn kept() -> &'static Mutex<HashSet<String>> {
+    static KEPT: OnceLock<Mutex<HashSet<String>>> = OnceLock::new();
+    KEPT.get_or_init(Default::default)
+}
+
+fn line(chat: &str, id: &str) -> String {
+    format!("{chat}\t{id}")
+}
+
+/// Whether a revoke for everyone leaves this message as it is: someone
+/// else's message with something still to show. Our own deletions, from here
+/// or the phone, still clear our copy.
+pub fn keeps(old: &Message) -> bool {
+    !old.from_me && !matches!(old.content, Content::Revoked | Content::PhoneOnly { .. })
+}
+
+/// Restores the marks this archive kept, when the backend starts.
+pub fn load(archive: &Archive) {
+    let Ok(Some(stored)) = archive.meta(META_KEY) else {
+        return;
+    };
+    let mut kept = kept().lock().unwrap_or_else(PoisonError::into_inner);
+    kept.extend(stored.lines().map(str::to_owned));
+}
+
+/// Marks a message its sender deleted for everyone and saves the mark.
+pub fn remember(archive: &Archive, chat: &str, id: &str) {
+    let line = line(chat, id);
+    kept()
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .insert(line.clone());
+    let stored = archive.meta(META_KEY).ok().flatten().unwrap_or_default();
+    if stored.lines().any(|kept| kept == line) {
+        return;
+    }
+    let value = if stored.is_empty() {
+        line
+    } else {
+        format!("{stored}\n{line}")
+    };
+    if let Err(error) = archive.set_meta(META_KEY, &value) {
+        log::warn!("could not save a kept deletion: {error}");
+    }
+}
+
+/// Whether the sender deleted this message for everyone after it arrived.
+pub fn contains(chat: &str, id: &str) -> bool {
+    kept()
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .contains(&line(chat, id))
+}
