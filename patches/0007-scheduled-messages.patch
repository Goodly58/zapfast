+/// Patched build: the messages waiting to be sent to this chat, soonest
+/// first, each with a way to cancel it.
+fn scheduled_strip(app: &mut App, ui: &mut egui::Ui, chat: &str) {
+    let items = crate::scheduled::for_chat(chat);
+    if items.is_empty() {
+        return;
+    }
+    let palette = app.palette;
+    widgets::raised(ui, &palette, strip_frame(&palette), |ui| {
+        ui.set_width(ui.available_width());
+        for item in &items {
+            ui.horizontal(|ui| {
+                theme::icon(ui, Icon::Clock, 16.0, palette.accent);
+                theme::text(
+                    ui,
+                    crate::scheduled::when_label(item.at),
+                    theme::semibold(12.5),
+                    palette.accent,
+                );
+                let preview = item.text.lines().next().unwrap_or_default().to_owned();
+                let width = (ui.available_width() - 30.0).max(0.0);
+                ui.allocate_ui_with_layout(
+                    vec2(width, 18.0),
+                    Layout::left_to_right(Align::Center),
+                    |ui| {
+                        theme::text(ui, preview, theme::regular(12.5), palette.secondary);
+                    },
+                );
+                if theme::icon_button(
+                    ui,
+                    Icon::X,
+                    16.0,
+                    palette.secondary,
+                    palette.text,
+                    "Cancel scheduled message",
+                )
+                .clicked()
+                {
+                    app.cancel_scheduled(item.id);
+                }
+            });
+        }
+    });
+    strip_gap(ui);
+}
+
+/// Patched build: the Send button's right-click menu, which sends the
+/// composed text later instead of now.
+fn schedule_menu(app: &mut App, ui: &mut egui::Ui, chat: &str) {
+    let palette = app.palette;
+    let now = crate::util::now();
+    let mut chosen = None;
+    theme::text(ui, "Send later", theme::semibold(12.5), palette.secondary);
+    for (label, at) in crate::scheduled::presets(now) {
+        if widgets::menu_item(ui, &palette, Some(Icon::Clock), &label) {
+            chosen = Some(at);
+        }
+    }
+    let id = egui::Id::new("schedule-at");
+    let mut custom = ui.data(|data| data.get_temp::<String>(id)).unwrap_or_default();
+    let custom_at = crate::scheduled::next_at(now, &custom);
+    ui.horizontal(|ui| {
+        ui.add(
+            egui::TextEdit::singleline(&mut custom)
+                .hint_text("21:30")
+                .desired_width(56.0),
+        );
+        let label = match custom_at {
+            Some(at) => format!("Send {}", crate::scheduled::when_label(at)),
+            None => "Send at a time".to_owned(),
+        };
+        if ui
+            .add_enabled(custom_at.is_some(), egui::Button::new(label))
+            .clicked()
+        {
+            chosen = custom_at;
+        }
+    });
+    ui.data_mut(|data| data.insert_temp(id, custom));
+    if let Some(at) = chosen {
+        let text = std::mem::take(&mut app.composer);
+        app.schedule_text(chat.to_owned(), text, at);
+        app.focus_composer = true;
+        ui.close();
+    }
+}
